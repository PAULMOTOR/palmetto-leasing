# ── Public site ─────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://palmettoleasing.com
VITE_PUBLIC_SITE_URL=https://palmettoleasing.com
VITE_PUBLIC_HOSTNAME=palmettoleasing.com
VITE_AUTH_ENABLED=false

# ── Neon (inventory / crawler) — SEPARATE project from CRM ──────────────────
# Create at console.neon.tech → New Project "palmetto-leasing"
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ── Cron protection ─────────────────────────────────────────────────────────
CRON_SECRET=change-me-long-random

# ── Quote defaults ──────────────────────────────────────────────────────────
QUOTE_BASE_INTEREST_RATE=0.059
QUOTE_TERM_MONTHS=36
QUOTE_RESIDUAL_RATE=0.5
QUOTE_DOWN_PAYMENT_RATE=0.2

# ── Portals ─────────────────────────────────────────────────────────────────
ADMIN_PIN=palmetto
DEALER_PIN=dealer

# ── CRM handoff (optional, separate Vercel project) ─────────────────────────
CRM_HANDOFF_URL=
CRM_HANDOFF_SECRET=
CRM_STATUS_URL=

# ── Grok Imagine (unique per-car studio thumbs) ─────────────────────────────
# Create key at https://console.x.ai — image edit uses dealer photos as reference
XAI_API_KEY=
IMAGINE_MAX_PER_CRAWL=20

# ── Image-fix email ─────────────────────────────────────────────────────────
# Easiest: Admin → Image / support email → Gmail app password → Save & send test
IMAGE_SUPPORT_EMAIL=Jeremyp@paulmotorcompany.com
GMAIL_USER=Jeremyp@paulmotorcompany.com
GMAIL_APP_PASSWORD=
# RESEND_API_KEY=
# RESEND_FROM=Palmetto Leasing <noreply@palmettoleasing.com>
