# ── Palmetto marketing site (palmettoleasing.com) ──────────────────────────
# Public URL of this Vercel deployment (no trailing slash)
PUBLIC_SITE_URL=https://palmettoleasing.com
VITE_PUBLIC_SITE_URL=https://palmettoleasing.com
VITE_PUBLIC_HOSTNAME=palmettoleasing.com

# ── CRM handoff (separate Vercel project — optional until CRM endpoint exists)
# Server-only. Never prefix with VITE_ or NEXT_PUBLIC_
CRM_HANDOFF_URL=
CRM_HANDOFF_SECRET=
# Optional: client application status lookup against CRM
CRM_STATUS_URL=

# ── Live lease quote defaults (edit in Vercel → Settings → Environment Variables)
QUOTE_BASE_INTEREST_RATE=0.059
QUOTE_TERM_MONTHS=36
QUOTE_RESIDUAL_RATE=0.5
QUOTE_DOWN_PAYMENT_RATE=0.2

# ── Portal PINs (server-only)
ADMIN_PIN=palmetto
DEALER_PIN=dealer

# ── Auth (optional). Marketing site works with auth disabled.
VITE_AUTH_ENABLED=false

# ── Do NOT set these on this project ───────────────────────────────────────
# DATABASE_URL=
# NEON_DATABASE_URL=
# CRM_DATABASE_URL=
